NODE_ENV=production
PORT=10000
CLIENT_URL=https://yourdomain.com
BASE_URL=https://api.yourdomain.com

# Database - PostgreSQL
DATABASE_URL=postgresql://username:password@host:5432/database_name?sslmode=require

# JWT Authentication (use strong random strings, min 32 chars)
JWT_ACCESS_SECRET=your-access-secret-min-32-chars-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-change-in-production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# File Storage - Cloudinary (recommended for production)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional: Supabase Storage (alternative to Cloudinary)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: Redis (recommended for production rate limiting)
# REDIS_URL=redis://user:password@host:6379

# Server Identification
SERVER_ID=hok-api-01

# Admin Seeding (set on first deploy only)
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=your-secure-admin-password

# Support email (receives newsletter subscription notifications)
SUPPORT_EMAIL=info@hokinteriors.co.ke

# Email (Brevo / Sendinblue) — used for order confirmations and newsletter notifications
# Email delivery — HostPinnacle SMTP (primary).
# Set SMTP_HOST, SMTP_PORT, SMTP_SECURE, SMTP_USER, and SMTP_PASSWORD in the
# cPanel Node.js App environment variables. The SMTP_PASSWORD must NEVER be
# committed to Git and must NEVER appear in frontend code.
SMTP_HOST=mail.hokinteriors.co.ke
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@hokinteriors.co.ke
SMTP_FROM=HOK Interiors <info@hokinteriors.co.ke>
# SMTP_PASSWORD=<set in production environment only — do not commit>

# Fallback: Brevo / Sendinblue
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=your-verified-sender@example.com

# Login-notification email toggle
# LOGIN_NOTIFICATION_ENABLED=true
