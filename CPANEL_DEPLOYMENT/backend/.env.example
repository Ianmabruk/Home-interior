NODE_ENV=production
PORT=10000
CLIENT_URL=https://yourdomain.com
BASE_URL=https://api.yourdomain.com

# Database - PostgreSQL
DATABASE_URL=postgresql://username:password@host:5432/database_name?sslmode=require

# JWT Authentication (use strong random strings, min 32 chars)
JWT_ACCESS_SECRET=your-access-secret-min-32-chars-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-change-in-production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# File Storage - Cloudinary (recommended for production)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional: Supabase Storage (alternative to Cloudinary)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: Redis (recommended for production rate limiting)
# REDIS_URL=redis://user:password@host:6379

# Server Identification
SERVER_ID=hok-api-01

# Admin Seeding (set on first deploy only)
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=your-secure-admin-password
